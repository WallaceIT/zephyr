#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		/*
		 * shared memory reserved for the inter-processor communication
		 */
		zephyr,ipc_shm = &shmem;
		zephyr,ipc_rsc_table = &rsc_table;
		zephyr,ipc = &mailbox0;

		i2c-controller = &lpi2c4;
		spi-controller = &lpspi3;
		gpio-controller = &gpio2;
	};

	aliases {
		/delete-property/ led0;
		/delete-property/ led1;
		/delete-property/ sw0;
	};

	/delete-node/ leds;
	/delete-node/ keys;

	shmem: memory@a4000000 {
		compatible = "mmio-sram";
		reg = <0xa4000000 0x500000>;
	};

	rsc_table: memory@2001e000 {
		compatible = "mmio-sram";
		reg = <0x2001e000 0x100>;
	};

	mailbox0: mailbox {
		compatible = "zephyr,mbox-ipm";
		mboxes = <&mu1 1>, <&mu1 1>;
		mbox-names = "tx", "rx";
		status = "okay";
	};
};

&gpio2 {
	status = "okay";
};

&mu1 {
	status = "okay";
};

&lpi2c4 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c4_default>;
	pinctrl-names = "default";
	status = "okay";
};

&spi3_default {
	// CS lines are driven as GPIOs, remove them from the spi3 pinmuxing
	group0 {
		pinmux = <&iomuxc1_gpio_io09_lpspi_sin_lpspi3_sin>,
			 <&iomuxc1_gpio_io10_lpspi_sout_lpspi3_sout>,
			 <&iomuxc1_gpio_io11_lpspi_sck_lpspi3_sck>;
		slew-rate = "fast";
		drive-strength = "x5";
	};
};

&lpspi3 {
	clock-frequency = <DT_FREQ_M(2)>;
	pinctrl-0 = <&spi3_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio2 25 GPIO_ACTIVE_LOW>, <&gpio2 7 GPIO_ACTIVE_LOW>;
	transfer-delay = <100>;
	tx-fifo-size = <8>;
	rx-fifo-size = <8>;
	status = "okay";
};
